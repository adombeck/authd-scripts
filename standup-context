#!/usr/bin/env python3
"""
standup-context
Outputs structured GitHub activity since the last daily standup (Mon-Fri 14:30 Berlin).

Usage:
  standup-context            – print activity since last standup
  standup-context --install  – install systemd user timer to run daily at 14:15 Berlin

Override the cutoff with: STANDUP_SINCE=2026-06-27T12:30:00Z ./standup-context
"""

import argparse
import json
import os
import subprocess
from concurrent.futures import ThreadPoolExecutor, as_completed
from datetime import datetime, timedelta, timezone
from pathlib import Path
from zoneinfo import ZoneInfo

STANDUP_TZ = ZoneInfo("Europe/Berlin")
STANDUP_CUTOFF_TIME = (14, 30)  # hour, minute local Berlin time


def install_timer():
    script_dir = Path(__file__).resolve().parent
    unit_src = script_dir / "systemd"
    config_home = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    systemd_user_dir = config_home / "systemd" / "user"
    systemd_user_dir.mkdir(parents=True, exist_ok=True)

    for unit_name in ("standup-context.service", "standup-context.timer"):
        content = (unit_src / unit_name).read_text().replace("@SCRIPT_DIR@", str(script_dir))
        dst = systemd_user_dir / unit_name
        dst.write_text(content)
        print(f"Installed {dst}")

    subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)
    subprocess.run(["systemctl", "--user", "enable", "--now", "standup-context.timer"], check=True)
    print()
    subprocess.run(["systemctl", "--user", "list-timers", "standup-context.timer"])


def since_datetime():
    now = datetime.now(STANDUP_TZ)
    days_back = 3 if now.weekday() == 0 else 1  # Monday → back to Friday
    cutoff = (now - timedelta(days=days_back)).replace(
        hour=STANDUP_CUTOFF_TIME[0], minute=STANDUP_CUTOFF_TIME[1], second=0, microsecond=0
    )
    return cutoff.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def fmt(ts):
    return ts[:16].replace("T", " ") + " UTC"


def indent(text, prefix="    "):
    """Indent multi-line body text for display under a list item."""
    if not text or not text.strip():
        return ""
    return "\n".join(prefix + line for line in text.strip().splitlines())


def fetch_pr_info(repo, num):
    try:
        result = subprocess.run(
            ["gh", "api", f"/repos/{repo}/pulls/{num}", "--jq", "[.title, (.body // \"\")]"],
            capture_output=True, text=True, timeout=10,
        )
        title, body = json.loads(result.stdout.strip())
        return (repo, num), (title or "(unknown)", body or "")
    except Exception:
        return (repo, num), ("(unknown)", "")


def main():
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("--install", action="store_true", help="Install systemd user timer")
    args = parser.parse_args()

    if args.install:
        install_timer()
        return

    since = os.environ.get("STANDUP_SINCE") or since_datetime()

    github_user = subprocess.run(
        ["gh", "api", "/user", "--jq", ".login"], capture_output=True, text=True, check=True
    ).stdout.strip()

    print(f"GitHub activity for @{github_user}")
    print(f"Since: {since}")
    print(f"Generated: {datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')}")
    print()

    all_events = json.loads(subprocess.run(
        ["gh", "api", f"/users/{github_user}/events?per_page=100"],
        capture_output=True, text=True, check=True,
    ).stdout)

    events = [e for e in all_events if e.get("created_at", "") >= since]

    # Warn if we may have hit the 100-event cap and could be missing data
    oldest = min((e["created_at"] for e in all_events), default="")
    if len(all_events) == 100 and oldest > since:
        print("⚠️  Warning: 100-event API cap reached; activity before", oldest[:16], "UTC may be missing.")
        print()

    if not events:
        print("No GitHub activity found since the last standup.")
        return

    # Collect unique PR (repo, number) pairs whose title+body need fetching
    # (the Events API omits PR titles/bodies in PullRequest* payloads)
    pr_keys = set()
    for e in events:
        if e["type"] in ("PullRequestEvent", "PullRequestReviewEvent", "PullRequestReviewCommentEvent"):
            num = e["payload"].get("number") or e["payload"].get("pull_request", {}).get("number")
            if num:
                pr_keys.add((e["repo"]["name"], num))

    pr_cache = {}  # (repo, num) -> (title, body)
    with ThreadPoolExecutor(max_workers=8) as pool:
        for key, info in (f.result() for f in as_completed(
            pool.submit(fetch_pr_info, repo, num) for repo, num in pr_keys
        )):
            pr_cache[key] = info

    def pr_title(repo, num):
        return pr_cache.get((repo, num), ("(unknown)", ""))[0]

    def pr_body(repo, num):
        return pr_cache.get((repo, num), ("(unknown)", ""))[1]

    # --- PRs Opened ---
    opened_prs = [
        (e["created_at"], e["repo"]["name"], e["payload"]["number"])
        for e in events
        if e["type"] == "PullRequestEvent" and e["payload"].get("action") == "opened"
    ]
    if opened_prs:
        print("### PRs Opened")
        for ts, repo, num in sorted(opened_prs):
            print(f"  - {repo}#{num}: {pr_title(repo, num)} [{fmt(ts)}]")
            body = pr_body(repo, num)
            if body:
                print(indent(body))
        print()

    # --- PRs Reviewed ---
    # Deduplicate per (repo, PR number); prefer 'approved' over 'commented'
    reviews = {}
    for e in events:
        if e["type"] == "PullRequestReviewEvent":
            pr = e["payload"].get("pull_request", {})
            rev = e["payload"].get("review", {})
            repo = e["repo"]["name"]
            num = pr.get("number")
            state = rev.get("state", "commented").lower()
            body = (rev.get("body") or "").strip()
            key = (repo, num)
            if key not in reviews or state == "approved":
                reviews[key] = (e["created_at"], repo, num, state, body)
    if reviews:
        print("### PRs Reviewed")
        for _, (ts, repo, num, state, body) in sorted(reviews.items()):
            print(f"  - [{state}] {repo}#{num}: {pr_title(repo, num)} [{fmt(ts)}]")
            if body:
                print(indent(body))
        print()

    # --- PR Review Comments (inline) ---
    review_comments = [
        (
            e["created_at"],
            e["repo"]["name"],
            e["payload"].get("pull_request", {}).get("number"),
            e["payload"].get("comment", {}).get("path", ""),
            (e["payload"].get("comment", {}).get("body") or "").strip(),
        )
        for e in events
        if e["type"] == "PullRequestReviewCommentEvent" and e["payload"].get("action") == "created"
    ]
    if review_comments:
        print("### PR Review Comments (inline)")
        for ts, repo, num, path, body in sorted(review_comments):
            print(f"  - {repo}#{num} {path} [{fmt(ts)}]")
            if body:
                print(indent(body))
        print()

    # --- Issues Opened ---
    opened_issues = [
        (
            e["created_at"],
            e["repo"]["name"],
            e["payload"].get("issue", {}).get("number"),
            e["payload"].get("issue", {}).get("title", "(unknown)"),
            (e["payload"].get("issue", {}).get("body") or "").strip(),
        )
        for e in events
        if e["type"] == "IssuesEvent" and e["payload"].get("action") == "opened"
    ]
    if opened_issues:
        print("### Issues Opened")
        for ts, repo, num, title, body in sorted(opened_issues):
            print(f"  - {repo}#{num}: {title} [{fmt(ts)}]")
            if body:
                print(indent(body))
        print()

    # --- Commits Pushed ---
    pushes = []
    seen_shas = set()
    for e in events:
        if e["type"] == "PushEvent":
            p = e["payload"]
            ref = p.get("ref", "").replace("refs/heads/", "")
            repo = e["repo"]["name"]
            ts = e["created_at"]
            for c in p.get("commits", []):
                sha = c.get("sha", "")[:8]
                if sha and sha not in seen_shas:
                    seen_shas.add(sha)
                    msg = c.get("message", "")
                    pushes.append((ts, repo, ref, sha, msg))
    if pushes:
        print("### Commits Pushed")
        for ts, repo, ref, sha, msg in sorted(pushes):
            lines = msg.strip().splitlines()
            print(f"  - {repo} ({ref}) {sha}: {lines[0] if lines else ''} [{fmt(ts)}]")
            rest = "\n".join(lines[1:]).strip()
            if rest:
                print(indent(rest))
        print()

    # --- Issue/PR Comments ---
    comments = [
        (
            e["created_at"],
            e["repo"]["name"],
            e["payload"].get("issue", {}).get("number"),
            e["payload"].get("issue", {}).get("title", "(unknown)"),
            (e["payload"].get("comment", {}).get("body") or "").strip(),
        )
        for e in events
        if e["type"] == "IssueCommentEvent" and e["payload"].get("action") == "created"
    ]
    if comments:
        print("### Commented on Issues/PRs")
        for ts, repo, num, title, body in sorted(comments):
            print(f"  - {repo}#{num}: {title} [{fmt(ts)}]")
            if body:
                print(indent(body))
        print()

    print("---")
    print(f"Total events in window: {len(events)}")


if __name__ == "__main__":
    main()
