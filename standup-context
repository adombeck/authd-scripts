#!/usr/bin/env python3
"""
standup-context
Outputs structured GitHub + Jira activity since the last daily standup (Mon-Fri 14:30 Berlin).

Usage:
  standup-context            – print activity since last standup
  standup-context --install  – install systemd user timer to run daily at 14:15 Berlin

Override the cutoff with: STANDUP_SINCE=2026-06-27T12:30:00Z ./standup-context
"""

import argparse
import base64
import contextlib
import io
import json
import os
import re
import subprocess
import sys
import tempfile
import urllib.error
import urllib.parse
import urllib.request
from concurrent.futures import ThreadPoolExecutor, as_completed
from datetime import datetime, timedelta, timezone
from pathlib import Path
from zoneinfo import ZoneInfo

STANDUP_TZ = ZoneInfo("Europe/Berlin")
STANDUP_CUTOFF_TIME = (14, 30)  # hour, minute local Berlin time

JIRA_URL = "https://warthogs.atlassian.net"
JIRA_KEY_RE = re.compile(r'\b([A-Z]{2,10}-\d+)\b')


def install_timer():
    script_dir = Path(__file__).resolve().parent
    unit_src = script_dir / "systemd"
    config_home = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    systemd_user_dir = config_home / "systemd" / "user"
    systemd_user_dir.mkdir(parents=True, exist_ok=True)

    for unit_name in ("standup-context.service", "standup-context.timer"):
        content = (unit_src / unit_name).read_text().replace("@SCRIPT_DIR@", str(script_dir))
        dst = systemd_user_dir / unit_name
        dst.write_text(content)
        print(f"Installed {dst}")

    subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)
    subprocess.run(["systemctl", "--user", "enable", "--now", "standup-context.timer"], check=True)
    print()
    subprocess.run(["systemctl", "--user", "list-timers", "standup-context.timer"])


def since_datetime():
    now = datetime.now(STANDUP_TZ)
    days_back = 3 if now.weekday() == 0 else 1  # Monday → back to Friday
    cutoff = (now - timedelta(days=days_back)).replace(
        hour=STANDUP_CUTOFF_TIME[0], minute=STANDUP_CUTOFF_TIME[1], second=0, microsecond=0
    )
    return cutoff.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def fmt(ts):
    return ts[:16].replace("T", " ") + " UTC"


def indent(text, prefix="    "):
    """Indent multi-line body text for display under a list item."""
    if not text or not text.strip():
        return ""
    return "\n".join(prefix + line for line in text.strip().splitlines())


# ---------------------------------------------------------------------------
# Jira helpers
# ---------------------------------------------------------------------------

def load_jira_credentials():
    """Load credentials from ~/.jira_credentials (simple key: value format)."""
    creds = {}
    path = Path.home() / ".jira_credentials"
    if not path.exists():
        return {}
    for line in path.read_text().splitlines():
        if ': ' in line:
            key, _, val = line.partition(': ')
            creds[key.strip()] = val.strip().strip('"')
    return creds


def jira_request(path, creds):
    """Make a Jira REST API GET request; returns parsed JSON or None on error."""
    if not creds:
        return None
    token = base64.b64encode(f"{creds['user']}:{creds['token']}".encode()).decode()
    req = urllib.request.Request(
        f"{JIRA_URL}{path}",
        headers={"Authorization": f"Basic {token}", "Accept": "application/json"},
    )
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            return json.loads(resp.read())
    except Exception:
        return None


def find_jira_keys(text):
    """Return list of Jira issue keys found in text."""
    return JIRA_KEY_RE.findall(text or "")


def fetch_jira_activity(creds, since_iso):
    """Return {key: {summary, status}} for issues assigned to current user updated since given time."""
    if not creds:
        return {}
    dt = datetime.fromisoformat(since_iso.replace("Z", "+00:00"))
    jql_since = dt.astimezone(timezone.utc).strftime("%Y-%m-%d %H:%M")
    jql = f'assignee = currentUser() AND updated >= "{jql_since}" ORDER BY updated DESC'
    path = "/rest/api/3/search?" + urllib.parse.urlencode({
        "jql": jql, "fields": "summary,status", "maxResults": "50",
    })
    result = jira_request(path, creds)
    if not result:
        return {}
    return {
        issue["key"]: {
            "summary": issue["fields"]["summary"],
            "status": issue["fields"]["status"]["name"],
        }
        for issue in result.get("issues", [])
    }


def fetch_sprint_issue_keys(creds):
    """Return the set of issue keys in the active sprint for the configured board.

    Returns None if the board info is unavailable (so callers can distinguish
    "not on board" from "couldn't check").
    """
    if not creds or "board_id" not in creds:
        return None
    board_id = creds["board_id"]

    sprints = jira_request(f"/rest/agile/1.0/board/{board_id}/sprint?state=active", creds)
    if not sprints or not sprints.get("values"):
        return None
    sprint_id = sprints["values"][0]["id"]

    keys = set()
    start = 0
    while True:
        result = jira_request(
            f"/rest/agile/1.0/sprint/{sprint_id}/issue?"
            + urllib.parse.urlencode({"fields": "key", "startAt": start, "maxResults": 100}),
            creds,
        )
        if not result:
            break
        issues = result.get("issues", [])
        if not issues:
            break
        for issue in issues:
            keys.add(issue["key"])
        start += len(issues)
        if start >= result.get("total", 0):
            break
    return keys


def _fetch_one_jira_issue(key, creds):
    path = "/rest/api/3/issue/" + urllib.parse.quote(key) + "?" + urllib.parse.urlencode(
        {"fields": "summary,status"}
    )
    result = jira_request(path, creds)
    if not result:
        return key, None
    return key, {
        "summary": result["fields"]["summary"],
        "status": result["fields"]["status"]["name"],
    }


def fetch_jira_issues_by_keys(keys, creds, existing_cache):
    """Fetch Jira issues for keys not already in existing_cache. Returns merged cache."""
    cache = dict(existing_cache)
    missing = [k for k in keys if k not in cache]
    if not missing or not creds:
        return cache
    with ThreadPoolExecutor(max_workers=8) as pool:
        for key, info in (f.result() for f in as_completed(
            pool.submit(_fetch_one_jira_issue, k, creds) for k in missing
        )):
            cache[key] = info
    return cache


def first_name(login):
    """Extract a first-name-like string from a GitHub login or display name."""
    if not login:
        return ""
    return re.split(r'[-._\s]', login.strip())[0]


def gh_url(repo, num, is_pr):
    """Return the GitHub URL for a PR or issue."""
    return f"https://github.com/{repo}/{'pull' if is_pr else 'issues'}/{num}"


# ---------------------------------------------------------------------------
# GitHub helpers
# ---------------------------------------------------------------------------


def fetch_pr_info(repo, num):
    try:
        result = subprocess.run(
            ["gh", "api", f"/repos/{repo}/pulls/{num}", "--jq",
             "[.title, (.body // \"\"), (.assignee.login // \"\"), (.head.ref // \"\")]"],
            capture_output=True, text=True, timeout=10,
        )
        title, body, asgn_login, head_ref = json.loads(result.stdout.strip())
        return (repo, num), (title or "(unknown)", body or "", asgn_login or "", head_ref or "")
    except Exception:
        return (repo, num), ("(unknown)", "", "", "")

def fetch_pr_reviews(repo, num):
    """Return (repo, num), {reviewer_login: latest_state} for all submitted reviews."""
    try:
        result = subprocess.run(
            ["gh", "api", f"/repos/{repo}/pulls/{num}/reviews?per_page=100",
             "--jq", "[.[] | select(.state != \"PENDING\") | {login: .user.login, state: .state}]"],
            capture_output=True, text=True, timeout=10,
        )
        data = json.loads(result.stdout.strip() or "[]")
        reviewers = {}
        for r in data:
            reviewers[r["login"]] = r["state"]  # last submission per reviewer wins
        return (repo, num), reviewers
    except Exception:
        return (repo, num), {}


def run_standup_copilot(activity_text, out_path):
    with tempfile.NamedTemporaryFile(
        mode="w", suffix=".txt", prefix="standup-activity-", delete=False
    ) as f:
        f.write(activity_text)
        tmp_path = Path(f.name)
    try:
        prompt = (
            f"Read the file at {tmp_path}. It contains my GitHub and Jira activity since the last standup. "
            f"Write a standup summary in Markdown to {out_path}, creating the directory if needed. "
            "Start with a '# Standup YYYY-MM-DD' heading. "

            "Structure the content into ## sections matching the sprint board columns, "
            "in the order we review them during standup (right to left): "
            "'## Done', '## In Review', '## In Progress', '## To Do'. "
            "Only include a column section if there is activity to report for it. "
            "Place each item under the column that matches its Jira status. "
            "Items with no Jira issue, or whose Jira issue is not on the sprint board, "
            "go in a final '## Other' section. "

            "Within each column section, write one ### entry per logical unit of work. "
            "Grouping rules: "
            "(a) If a GitHub issue and a PR that closes it were both active (look for "
            "'Closes #N', 'Fixes #N', 'Resolves #N' in PR bodies), combine them into one ### entry "
            "and link both. "
            "(b) Multiple clearly related items (e.g. many new failures in the same test suite) "
            "may be grouped under one ### entry with a summarising heading; in that case include "
            "a bullet list inside the entry with a Markdown link for every individual item. "
            "Otherwise give each item its own ### entry. "

            "For the ### heading: if the item has a 'Jira:' annotation, use the Jira key as a "
            "Markdown link and the Jira title, e.g. "
            "'### [UDENG-1234](https://warthogs.atlassian.net/browse/UDENG-1234): Jira title'. "
            "Otherwise use the GitHub number as a Markdown link and title, e.g. "
            "'### [PR #123](url): Title' or '### [Issue #456](url): Title'. "
            "Use the 'GitHub URL:' annotation for the GitHub link. "
            "If the item has '[assigned to: Name]', append that to the heading in parentheses, "
            "e.g. '… (Alice's PR)'. "
            "For reviewed PRs, prefix the ### heading with 'Reviewed: ', e.g. "
            "'### Reviewed: [UDENG-1234](url): Title'. "
            "For push-only entries use the branch name as the heading if no Jira key is present. "

            "If a PR has 'Reviewed by:' information, mention the reviewer(s) by first name in "
            "the section body — e.g. 'Reviewed and approved by Alice.' or "
            "'Bob requested changes.' "
            "Always render Jira keys and GitHub PR/issue references as Markdown links. "
            "Prefix GitHub issues with 'Issue' and pull requests with 'PR'. "

            "If an item is marked '[no Jira issue]', put '⚠️ No Jira issue' as the very first line "
            "of the entry body, on its own line, before any description. "
            "If an item is marked '[not on sprint board]', put '⚠️ Not on sprint board' as the very "
            "first line of the entry body, on its own line, before any description. "

            "Under each ### heading write 1-3 sentences summarising what I did there — "
            "motivation first (why it was needed), then what was done and the current status. "
            "Do not repeat the title verbatim."
        )
        subprocess.run(
            ["copilot", "-p", prompt, "--yolo", "--output-format", "text",
             "--model", "claude-sonnet-4.6"],
            check=True,
        )
    finally:
        tmp_path.unlink(missing_ok=True)


def main():
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("--install", action="store_true", help="Install systemd user timer")
    args = parser.parse_args()

    if args.install:
        install_timer()
        return

    since = os.environ.get("STANDUP_SINCE") or since_datetime()

    github_user = subprocess.run(
        ["gh", "api", "/user", "--jq", ".login"], capture_output=True, text=True, check=True
    ).stdout.strip()

    all_events = json.loads(subprocess.run(
        ["gh", "api", f"/users/{github_user}/events?per_page=100"],
        capture_output=True, text=True, check=True,
    ).stdout)

    events = [e for e in all_events if e.get("created_at", "") >= since]

    # Fetch PR title/body/assignee/head-ref in parallel
    pr_cache = {}
    if events:
        pr_keys = set()
        for e in events:
            if e["type"] in ("PullRequestEvent", "PullRequestReviewEvent", "PullRequestReviewCommentEvent"):
                num = e["payload"].get("number") or e["payload"].get("pull_request", {}).get("number")
                if num:
                    pr_keys.add((e["repo"]["name"], num))
        with ThreadPoolExecutor(max_workers=8) as pool:
            for key, info in (f.result() for f in as_completed(
                pool.submit(fetch_pr_info, repo, num) for repo, num in pr_keys
            )):
                pr_cache[key] = info

    def pr_info(repo, num):
        return pr_cache.get((repo, num), ("(unknown)", "", "", ""))

    # Load Jira credentials; fetch Jira activity and sprint board keys in parallel
    jira_creds = load_jira_credentials()
    jira_activity = {}
    sprint_keys = None  # None = "couldn't determine"; set = known sprint contents
    if jira_creds:
        with ThreadPoolExecutor(max_workers=2) as pool:
            activity_fut = pool.submit(fetch_jira_activity, jira_creds, since)
            sprint_fut = pool.submit(fetch_sprint_issue_keys, jira_creds)
            jira_activity = activity_fut.result()
            sprint_keys = sprint_fut.result()

    # Collect every Jira key referenced across all GitHub activity
    all_jira_keys = set(jira_activity.keys())
    for e in events:
        p = e["payload"]
        if e["type"] in ("PullRequestEvent", "PullRequestReviewEvent", "PullRequestReviewCommentEvent"):
            num = p.get("number") or p.get("pull_request", {}).get("number")
            if num:
                t, b, _, head_ref = pr_info(e["repo"]["name"], num)
                all_jira_keys.update(find_jira_keys(t))
                all_jira_keys.update(find_jira_keys(b))
                all_jira_keys.update(find_jira_keys(head_ref))
        elif e["type"] in ("IssuesEvent", "IssueCommentEvent"):
            issue = p.get("issue", {})
            all_jira_keys.update(find_jira_keys(issue.get("title", "")))
            all_jira_keys.update(find_jira_keys(issue.get("body") or ""))
        elif e["type"] == "PushEvent":
            ref = p.get("ref", "").replace("refs/heads/", "")
            all_jira_keys.update(find_jira_keys(ref))
            for c in p.get("commits", []):
                all_jira_keys.update(find_jira_keys(c.get("message", "")))

    # Fetch any Jira issues not already loaded from the activity query
    jira_cache = fetch_jira_issues_by_keys(all_jira_keys, jira_creds, jira_activity)

    # Fetch reviews for PRs opened by the current user
    opened_pr_keys = {
        (e["repo"]["name"], e["payload"]["number"])
        for e in events
        if e["type"] == "PullRequestEvent" and e["payload"].get("action") == "opened"
    }
    reviews_cache = {}
    if opened_pr_keys:
        with ThreadPoolExecutor(max_workers=8) as pool:
            for key, reviewers in (f.result() for f in as_completed(
                pool.submit(fetch_pr_reviews, repo, num) for repo, num in opened_pr_keys
            )):
                reviews_cache[key] = reviewers

    # -----------------------------------------------------------------------
    # Output helpers (defined here to close over github_user, jira_cache, sprint_keys)
    # -----------------------------------------------------------------------

    def jira_matches_for(texts):
        """Return list of (key, info_or_none) for unique Jira keys found in texts."""
        seen = []
        result = []
        for text in texts:
            for key in find_jira_keys(text or ""):
                if key not in seen:
                    seen.append(key)
                    result.append((key, jira_cache.get(key)))
        return result

    def print_jira_annot(matches, referenced_keys):
        """Print Jira annotation lines; update referenced_keys in place."""
        if not matches:
            print("    [no Jira issue]")
            return
        for key, info in matches:
            referenced_keys.add(key)
            jira_link = f"{JIRA_URL}/browse/{key}"
            if info:
                on_board = sprint_keys is None or key in sprint_keys
                board_note = "" if on_board else " [not on sprint board]"
                print(f"    Jira: {key}: {info['summary']} ({info['status']}){board_note} — {jira_link}")
            else:
                print(f"    Jira: {key} (details unavailable) — {jira_link}")

    def print_gh_url(repo, num, is_pr):
        print(f"    GitHub URL: {gh_url(repo, num, is_pr)}")

    _REVIEW_STATE_LABELS = {
        "APPROVED": "approved",
        "CHANGES_REQUESTED": "changes requested",
        "COMMENTED": "commented",
        "DISMISSED": "dismissed",
    }

    def print_reviewers(repo, num):
        revs = {
            login: state
            for login, state in reviews_cache.get((repo, num), {}).items()
            if login != github_user
        }
        if revs:
            parts = [
                f"{first_name(login)} ({_REVIEW_STATE_LABELS.get(state, state.lower())})"
                for login, state in sorted(revs.items())
            ]
            print(f"    Reviewed by: {', '.join(parts)}")

    def print_assignee(asgn_login):
        if asgn_login and asgn_login != github_user:
            print(f"    [assigned to: {first_name(asgn_login)}]")

    # Capture all output so we can pass it to copilot
    buf = io.StringIO()
    github_referenced_jira_keys = set()
    with contextlib.redirect_stdout(buf):
        print(f"GitHub + Jira activity for @{github_user}")
        print(f"Since: {since}")
        print(f"Generated: {datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')}")
        print()

        oldest = min((e["created_at"] for e in all_events), default="")
        if len(all_events) == 100 and oldest > since:
            print("⚠️  Warning: 100-event API cap reached; activity before", oldest[:16], "UTC may be missing.")
            print()

        if not events and not jira_activity:
            print("No activity found since the last standup.")
        else:
            # --- PRs Opened ---
            opened_prs = [
                (e["created_at"], e["repo"]["name"], e["payload"]["number"])
                for e in events
                if e["type"] == "PullRequestEvent" and e["payload"].get("action") == "opened"
            ]
            if opened_prs:
                print("### PRs Opened")
                for ts, repo, num in sorted(opened_prs):
                    t, b, asgn_login, head_ref = pr_info(repo, num)
                    jm = jira_matches_for([t, b, head_ref])
                    print(f"  - PR {repo}#{num}: {t} [{fmt(ts)}]")
                    print_gh_url(repo, num, True)
                    print_jira_annot(jm, github_referenced_jira_keys)
                    print_assignee(asgn_login)
                    print_reviewers(repo, num)
                    if b:
                        print(indent(b))
                print()

            # --- PRs Reviewed ---
            # Deduplicate per (repo, PR number); prefer 'approved' over 'commented'
            reviews = {}
            for e in events:
                if e["type"] == "PullRequestReviewEvent":
                    pr = e["payload"].get("pull_request", {})
                    rev = e["payload"].get("review", {})
                    repo = e["repo"]["name"]
                    num = pr.get("number")
                    state = rev.get("state", "commented").lower()
                    body = (rev.get("body") or "").strip()
                    key = (repo, num)
                    if key not in reviews or state == "approved":
                        reviews[key] = (e["created_at"], repo, num, state, body)
            if reviews:
                print("### PRs Reviewed")
                for _, (ts, repo, num, state, body) in sorted(reviews.items()):
                    t, b, asgn_login, head_ref = pr_info(repo, num)
                    jm = jira_matches_for([t, b, head_ref])
                    print(f"  - PR {repo}#{num} [{state}]: {t} [{fmt(ts)}]")
                    print_gh_url(repo, num, True)
                    print_jira_annot(jm, github_referenced_jira_keys)
                    print_assignee(asgn_login)
                    if body:
                        print(indent(body))
                print()

            # --- PR Review Comments (inline) ---
            review_comments = [
                (
                    e["created_at"],
                    e["repo"]["name"],
                    e["payload"].get("pull_request", {}).get("number"),
                    e["payload"].get("comment", {}).get("path", ""),
                    (e["payload"].get("comment", {}).get("body") or "").strip(),
                )
                for e in events
                if e["type"] == "PullRequestReviewCommentEvent" and e["payload"].get("action") == "created"
            ]
            if review_comments:
                print("### PR Review Comments (inline)")
                for ts, repo, num, path, body in sorted(review_comments):
                    t, b, asgn_login, head_ref = pr_info(repo, num)
                    jm = jira_matches_for([t, b, head_ref])
                    print(f"  - PR {repo}#{num} {path} [{fmt(ts)}]")
                    print_gh_url(repo, num, True)
                    print_jira_annot(jm, github_referenced_jira_keys)
                    print_assignee(asgn_login)
                    if body:
                        print(indent(body))
                print()

            # --- Issues Opened ---
            opened_issues = [
                (
                    e["created_at"],
                    e["repo"]["name"],
                    e["payload"].get("issue", {}).get("number"),
                    e["payload"].get("issue", {}).get("title", "(unknown)"),
                    (e["payload"].get("issue", {}).get("body") or "").strip(),
                    (e["payload"].get("issue", {}).get("assignee") or {}).get("login", ""),
                )
                for e in events
                if e["type"] == "IssuesEvent" and e["payload"].get("action") == "opened"
            ]
            if opened_issues:
                print("### Issues Opened")
                for ts, repo, num, title, body, asgn_login in sorted(opened_issues):
                    jm = jira_matches_for([title, body])
                    print(f"  - Issue {repo}#{num}: {title} [{fmt(ts)}]")
                    print_gh_url(repo, num, False)
                    print_jira_annot(jm, github_referenced_jira_keys)
                    print_assignee(asgn_login)
                    if body:
                        print(indent(body))
                print()

            # --- Commits Pushed ---
            pushes = []
            seen_shas = set()
            for e in events:
                if e["type"] == "PushEvent":
                    p = e["payload"]
                    ref = p.get("ref", "").replace("refs/heads/", "")
                    repo = e["repo"]["name"]
                    ts = e["created_at"]
                    for c in p.get("commits", []):
                        sha = c.get("sha", "")[:8]
                        if sha and sha not in seen_shas:
                            seen_shas.add(sha)
                            msg = c.get("message", "")
                            pushes.append((ts, repo, ref, sha, msg))
            if pushes:
                print("### Commits Pushed")
                # Group by (repo, ref) to emit one Jira annotation per branch
                seen_branch_jira = set()
                for ts, repo, ref, sha, msg in sorted(pushes):
                    branch_key = (repo, ref)
                    lines = msg.strip().splitlines()
                    print(f"  - {repo} ({ref}) {sha}: {lines[0] if lines else ''} [{fmt(ts)}]")
                    if branch_key not in seen_branch_jira:
                        seen_branch_jira.add(branch_key)
                        jm = jira_matches_for([ref] + lines)
                        print_jira_annot(jm, github_referenced_jira_keys)
                    rest = "\n".join(lines[1:]).strip()
                    if rest:
                        print(indent(rest))
                print()

            # --- Issue/PR Comments ---
            comments = [
                (
                    e["created_at"],
                    e["repo"]["name"],
                    e["payload"].get("issue", {}).get("number"),
                    e["payload"].get("issue", {}).get("title", "(unknown)"),
                    (e["payload"].get("comment", {}).get("body") or "").strip(),
                    (e["payload"].get("issue", {}).get("assignee") or {}).get("login", ""),
                    bool(e["payload"].get("issue", {}).get("pull_request")),
                )
                for e in events
                if e["type"] == "IssueCommentEvent" and e["payload"].get("action") == "created"
            ]
            if comments:
                print("### Commented on Issues/PRs")
                for ts, repo, num, title, body, asgn_login, is_pr in sorted(comments):
                    jm = jira_matches_for([title, body])
                    kind = "PR" if is_pr else "Issue"
                    print(f"  - {kind} {repo}#{num}: {title} [{fmt(ts)}]")
                    print_gh_url(repo, num, is_pr)
                    print_jira_annot(jm, github_referenced_jira_keys)
                    print_assignee(asgn_login)
                    if body:
                        print(indent(body))
                print()

            # --- Jira-only activity (no corresponding GitHub events) ---
            jira_only = {k: v for k, v in jira_activity.items() if k not in github_referenced_jira_keys}
            if jira_only:
                print("### Jira Activity (no GitHub activity)")
                for key, info in sorted(jira_only.items()):
                    on_board = sprint_keys is None or key in sprint_keys
                    board_note = "" if on_board else " [not on sprint board]"
                    jira_link = f"{JIRA_URL}/browse/{key}"
                    print(f"  - {key}: {info['summary']} ({info['status']}){board_note} — {jira_link}")
                print()

            print("---")
            print(f"Total GitHub events in window: {len(events)}")
            if jira_activity:
                print(f"Total Jira issues updated in window: {len(jira_activity)}")
            if sprint_keys is not None:
                print(f"Sprint board has {len(sprint_keys)} issues")

    activity_text = buf.getvalue()
    print(activity_text, end="")
    sys.stdout.flush()  # ensure activity text is flushed before copilot output begins

    date_str = datetime.now(STANDUP_TZ).strftime("%Y-%m-%d")
    out_path = Path.home() / "Documents" / "standups" / f"{date_str}.md"
    out_path.parent.mkdir(parents=True, exist_ok=True)

    run_standup_copilot(activity_text, out_path)

    subprocess.Popen(
        ["flatpak", "run", "org.gnome.gitlab.somas.Apostrophe", "--", str(out_path)]
    )


if __name__ == "__main__":
    main()
