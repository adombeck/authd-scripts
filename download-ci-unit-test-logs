#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
OUTPUT_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/authd-artifacts"

exec "${SCRIPT_DIR}/download-ci-workflow-artifacts" \
    --repo "canonical/authd" \
    --workflow "qa.yaml" \
    --branch "main" \
    --artifact-prefix "authd-go-tests-coverage-artifacts" \
    --job "Go Tests with Coverage Collection" \
    --output "$OUTPUT_DIR" \
    --extract "*.log" \
    "$@"
