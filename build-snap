#!/bin/bash

set -euo pipefail

BUILD_DIR="../build/broker-snap"
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
LIB_DIR="${SCRIPT_DIR}/lib"

usage() {
    echo "Usage: $0 --broker <broker> [snapcraft options]"
    echo
    echo "Build the broker snap."
    echo
    echo "Options:"
    echo "  --broker <broker>  The broker to use (msentraid or google)."
    echo
    echo "All other options are passed to snapcraft."
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --broker)
            BROKER="$2"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            break
            ;;
    esac
done

set -x

go mod vendor

./scripts/prepare-broker-variant-files --broker "${BROKER:-oidc}"

time snapcraft pack "$@"

SNAP_FILE=$(ls -t *.snap | head -n1)

# Use the snap name before the first underscore (drop version/arch) for squashfs root
SNAP_BASENAME=$(basename "${SNAP_FILE}" .snap)
SNAP_BASENAME=${SNAP_BASENAME%%_*}
squashfs_root_dir="${SNAP_BASENAME}-squashfs-root"

# Remove any existing directory
rm -rf "${squashfs_root_dir}"

# Extract the snap file
unsquashfs -dest "${squashfs_root_dir}" "${SNAP_FILE}"
