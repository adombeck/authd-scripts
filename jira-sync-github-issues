#!/usr/bin/env bash

set -euo pipefail

DEFAULT_REPO_DIR="$HOME/projects/authd"
DEFAULT_SINCE="2026-08-24T16:56:28Z"
STATE_FILE="${AUTHD_JIRA_SYNC_STATE_FILE:-${XDG_STATE_HOME:-$HOME/.local/state}/authd-scripts/last-jira-sync}"

usage() {
    cat <<EOF
Usage: $0 [--repo <directory>] [--since <ISO-8601 timestamp>]

Start an interactive Copilot session that creates missing Jira issues for
recent Jira-labeled issues in canonical/authd.

Options:
  --repo <directory>             Authd repository. Defaults to the current
                                 repository when it contains the sync config,
                                 otherwise $DEFAULT_REPO_DIR.
  --since <timestamp>            Override the saved look-back timestamp.
  -h, --help                     Show this help.

The saved look-back timestamp is stored in:
  $STATE_FILE
EOF
}

die() {
    echo "Error: $1" >&2
    exit 1
}

if [[ -n "${AUTHD_REPO_DIR:-}" ]]; then
    REPO_DIR="$AUTHD_REPO_DIR"
elif [[ -f "$PWD/.github/.jira_sync_config.yaml" ]]; then
    REPO_DIR="$PWD"
else
    REPO_DIR="$DEFAULT_REPO_DIR"
fi

SINCE_OVERRIDE=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --repo)
            [[ $# -ge 2 ]] || die "--repo requires a directory"
            REPO_DIR="$2"
            shift 2
            ;;
        --since)
            [[ $# -ge 2 ]] || die "--since requires an ISO-8601 timestamp"
            SINCE_OVERRIDE="$2"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            die "unknown option: $1"
            ;;
    esac
done

command -v copilot >/dev/null || die "copilot was not found in PATH"
[[ -d "$REPO_DIR" ]] || die "repository directory not found: $REPO_DIR"
REPO_DIR="$(cd -- "$REPO_DIR" && pwd -P)"
[[ -f "$REPO_DIR/.github/.jira_sync_config.yaml" ]] \
    || die "sync config not found: $REPO_DIR/.github/.jira_sync_config.yaml"

mkdir -p -- "$(dirname -- "$STATE_FILE")"

if [[ -n "$SINCE_OVERRIDE" ]]; then
    SINCE="$SINCE_OVERRIDE"
elif [[ -s "$STATE_FILE" ]]; then
    SINCE="$(<"$STATE_FILE")"
else
    SINCE="$DEFAULT_SINCE"
fi

[[ -n "$SINCE" ]] || die "look-back timestamp is empty"
RUN_STARTED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
SESSION_NAME="GitHub-to-Jira sync $RUN_STARTED_AT"

read -r -d '' PROMPT <<EOF || true
the github to jira sync (https://github.com/canonical/gh-jira-sync-bot) is broken currently.
create jira issues for the recent github issues which have the jira label and don't have a corresponding jira ticket.
take ./.github/.jira_sync_config.yaml into account.
you can use the API token at ~/.jira_credentials.

only consider github issues created after $SINCE
EOF

echo "Starting Copilot Jira sync for issues created or updated since $SINCE"
echo "Repository: $REPO_DIR"
echo "State file: $STATE_FILE"

if copilot --name "$SESSION_NAME" -C "$REPO_DIR" -i "$PROMPT"; then
    temporary_state="$(mktemp "${STATE_FILE}.tmp.XXXXXX")"
    printf '%s\n' "$RUN_STARTED_AT" >"$temporary_state"
    mv -- "$temporary_state" "$STATE_FILE"
    echo "Look-back cursor saved: $RUN_STARTED_AT"
else
    status=$?
    echo "Copilot session failed; look-back cursor was not advanced." >&2
    exit "$status"
fi
