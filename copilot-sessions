#!/usr/bin/env bash
set -euo pipefail

DIR="${1:-$PWD}"
DIR="$(realpath "$DIR")"

for session_dir in ~/.copilot/session-state/*/; do
    workspace="$session_dir/workspace.yaml"
    [ -f "$workspace" ] || continue

    cwd="$(grep '^cwd: ' "$workspace" | sed 's/^cwd: //')"
    [ -n "${cwd:-}" ] || continue

    case "$cwd" in
        "$DIR"|"$DIR"/*)
            session_id="$(basename "$session_dir")"
            name="$(grep '^name: ' "$workspace" | sed 's/^name: //')"
            updated_at="$(grep '^updated_at: ' "$workspace" | sed 's/^updated_at: //')"
            branch="$(grep '^branch: ' "$workspace" | sed 's/^branch: //')"
            printf "%s\t%s\t%s\t%s\t%s\n" \
                "${updated_at:-1970-01-01T00:00:00.000Z}" \
                "${name:-<unnamed>}" "$session_id" \
                "${branch:-}" "$cwd"
            ;;
    esac
done | sort -r | while IFS=$'\t' read -r updated_at name session_id branch cwd; do
    printf "%s\t%s\t%s\t%s\n" "$name" "$session_id" "$branch" "$updated_at"
done

