#!/bin/bash

set -euo pipefail

usage() {
        cat << EOF
Usage: $0 --broker <broker> [snapcraft options]

Build the broker snap. The snap is extracted into a squashfs root directory
after building, which can be installed via 'sudo snap try <squashfs-root-dir>'.

Options:
  --broker <broker>  The broker to use (oidc, msentraid or google).

All other options are passed to snapcraft.
EOF
}

# Parse arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        --broker)
            BROKER="$2"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            break
            ;;
    esac
done

set -x

go mod vendor

./snap/scripts/prepare-variant --broker "${BROKER:-oidc}"

time snapcraft pack "$@"

SNAP_FILE=$(ls -t *.snap | head -n1)

# Use the snap name before the first underscore (drop version/arch) for squashfs root
SNAP_BASENAME=$(basename "${SNAP_FILE}" .snap)
SNAP_BASENAME=${SNAP_BASENAME%%_*}
squashfs_root_dir="${SNAP_BASENAME}-squashfs-root"

# Remove any existing directory
rm -rf "${squashfs_root_dir}"

# Extract the snap file
unsquashfs -dest "${squashfs_root_dir}" "${SNAP_FILE}"
