#!/bin/bash

set -euo pipefail

usage() {
        cat << EOF
Usage: $0 --broker <broker> [--build-dir <dir>] [--snap-src-dir <dir>] [snapcraft options]

Builds the broker snap and extracts it into a squashfs root directory.
You can install the extracted snap with:
  sudo snap try <squashfs-root-dir>

This script must be run from the root of the authd repository (or any of its
worktrees).

The snap is built from a clean clone of the current worktree (HEAD plus
uncommitted changes) placed in a fixed directory shared across all worktrees and
brokers. This lets snapcraft reuse a single LXD build instance regardless of
which worktree you build from, keeping the Go and cargo caches warm instead of
rebuilding from scratch for every worktree.

Options:
  --broker <broker>
      The broker to use. Valid values are 'oidc', 'msentraid' and 'google'.
      This option is required.
  --build-dir <dir>
      Directory to place the built snap and the extracted squashfs root directory.
      Defaults to ../build.
  --snap-src-dir <dir>
      Fixed directory the worktree is cloned into and snapcraft is run from.
      Sharing one path across worktrees and brokers is what enables build-cache
      reuse, so only change this if you want a separate cache.
      Defaults to ~/projects/build/authd-broker-snap.

All other options are passed to snapcraft.
EOF
}

# Parse arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        --broker)
            BROKER="$2"
            shift 2
            ;;
        --build-dir)
            BUILD_DIR="$2"
            shift 2
            ;;
        --snap-src-dir)
            SNAP_SRC_DIR="$2"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            break
            ;;
    esac
done

if [ -z "${BROKER:-}" ]; then
    echo >&2 "Error: --broker option is required"
    usage
    exit 1
fi

# Resolve the output directory relative to the current worktree before we cd
# into the shared build directory.
BUILD_DIR=${BUILD_DIR:-"$(realpath ../build)"}
SNAP_SRC_DIR=${SNAP_SRC_DIR:-"${HOME}/projects/build/authd-broker-snap"}

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

set -x

# Build from a fixed directory shared across all worktrees, refreshed in place
# so its inode stays stable: snapcraft names its LXD build instance after the
# project directory's inode, so one warm build instance is reused across
# worktrees (recreating the directory would spawn a new instance every build).
# --ensure-main: snap/scripts/version needs a local 'main' for non-main branches.
# --self-contained-submodules: snapcraft copies .git into the build instance,
# where any 'alternates' link back to this host would break 'git status'.
"${SCRIPT_DIR}/create-build-dir" \
    --build-dir "${SNAP_SRC_DIR}" \
    --in-place \
    --ensure-main \
    --self-contained-submodules
cd "${SNAP_SRC_DIR}"

go mod vendor

./snap/scripts/prepare-variant --broker "${BROKER}"

# Force a fresh pull of the 'broker' part. snapcraft's local source copy is
# additive: when re-pulling into the reused build instance it never deletes
# files that have since been removed from the source. Switching branches can
# therefore leave a stale .go file behind (e.g. a since-removed source file)
# which then collides with the current sources and breaks 'go build'. Cleaning
# only the 'broker' part wipes its lifecycle state without touching
# libhimmelblau (and its cargo cache), so builds stay fast.
#
# Also clean the 'version' part. It computes the snap version (via adopt-info)
# from the git state and exports it as a project variable. Once its BUILD step
# has run, snapcraft caches that variable and skips the step on subsequent
# packs ("already ran"), reusing the stale version from whichever git state the
# build instance was first created with — even though the script recomputes the
# correct value, the cached variable is what ends up in the .snap filename and
# the embedded -ldflags Version. Cleaning the part forces a recompute.
snapcraft clean broker version

time snapcraft pack "$@"

# shellcheck disable=SC2012 # The .snap file doesn't contain non-alphanumeric characters
SNAP_FILE=$(ls -t *.snap | head -n1)

# Move the snap file to the build directory
mkdir -p "${BUILD_DIR}"
mv "${SNAP_FILE}" "${BUILD_DIR}/"
SNAP_FILE="${BUILD_DIR}/$(basename "${SNAP_FILE}")"

# Use the snap name before the first underscore (drop version/arch) for squashfs root
SNAP_BASENAME=$(basename "${SNAP_FILE}" .snap)
SNAP_BASENAME=${SNAP_BASENAME%%_*}
squashfs_root_dir="${BUILD_DIR}/${SNAP_BASENAME}-squashfs-root"

# Remove any existing directory
rm -rf "${squashfs_root_dir}"

# Extract the snap file
unsquashfs -dest "${squashfs_root_dir}" "${SNAP_FILE}"
