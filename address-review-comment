#!/usr/bin/env python3
"""
address-review-comment - create/open a worktree and launch Copilot CLI to
address a single GitHub PR review comment.

Usage: address-review-comment <github-pr-comment-url>

Supports:
  https://github.com/owner/repo/pull/123#discussion_r456789
  https://github.com/owner/repo/pull/123#issuecomment-456789
"""

import re
import shlex
import subprocess
import sys
from pathlib import Path

AUTHD_REPO = Path("~/projects/authd").expanduser()

GUAKE_DBUS_DEST = "org.guake3.RemoteControl"
GUAKE_DBUS_OBJECT = "/org/guake3/RemoteControl"
GUAKE_DBUS_IFACE = "org.guake3.RemoteControl"

REVIEW_COMMENT_URL_RE = re.compile(
    r'https://github\.com/([^/]+)/([^/]+)/pull/(\d+)#discussion_r(\d+)'
)

ISSUE_COMMENT_URL_RE = re.compile(
    r'https://github\.com/([^/]+)/([^/]+)/pull/(\d+)#issuecomment-(\d+)'
)


def die(msg):
    print(f"Error: {msg}", file=sys.stderr)
    sys.exit(1)


def gh_api_json(path, jq):
    result = subprocess.run(
        ["gh", "api", path, "--jq", jq],
        capture_output=True, text=True,
    )
    if result.returncode != 0:
        die(f"gh api {path} failed: {result.stderr.strip()}")
    return result.stdout.strip()


def get_review_comment(owner, repo, comment_id):
    """Fetch the review comment's path, line, body and diff hunk."""
    result = subprocess.run(
        ["gh", "api", f"repos/{owner}/{repo}/pulls/comments/{comment_id}",
         "--jq", '{path, line, original_line, side, body, '
                 'user: .user.login, in_reply_to_id}'],
        capture_output=True, text=True,
    )
    if result.returncode != 0:
        die(f"Failed to fetch review comment {comment_id}: {result.stderr.strip()}")
    import json
    return json.loads(result.stdout)


def get_issue_comment(owner, repo, comment_id):
    """Fetch a top-level (non-review) PR comment's body and author."""
    result = subprocess.run(
        ["gh", "api", f"repos/{owner}/{repo}/issues/comments/{comment_id}",
         "--jq", '{body, user: .user.login}'],
        capture_output=True, text=True,
    )
    if result.returncode != 0:
        die(f"Failed to fetch issue comment {comment_id}: {result.stderr.strip()}")
    import json
    return json.loads(result.stdout)


def get_pr_branch(owner, repo, number):
    return gh_api_json(
        f"repos/{owner}/{repo}/pulls/{number}",
        ".head.ref",
    )


def guake_call(method, *args):
    subprocess.run(
        ["gdbus", "call", "--session",
         "--dest", GUAKE_DBUS_DEST,
         "--object-path", GUAKE_DBUS_OBJECT,
         "--method", f"{GUAKE_DBUS_IFACE}.{method}"] + list(args),
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )


def main():
    if len(sys.argv) != 2 or sys.argv[1] in ('-h', '--help'):
        print(__doc__.strip(), file=sys.stderr)
        sys.exit(0 if sys.argv[1:] == ['-h', '--help'] else 1)

    url = sys.argv[1]

    match = REVIEW_COMMENT_URL_RE.match(url)
    if match:
        owner, repo, number, comment_id = match.groups()

        print(f"Fetching review comment {comment_id} on {owner}/{repo}#{number}...")
        comment = get_review_comment(owner, repo, comment_id)

        line = comment.get("line") or comment.get("original_line")
        path = comment["path"]
        body = comment["body"]
        reviewer = comment.get("user") or "a reviewer"
        is_reply = comment.get("in_reply_to_id") is not None

        print(f"File: {path}:{line}")
        print(f"Reviewer: {reviewer}")
    else:
        match = ISSUE_COMMENT_URL_RE.match(url)
        if not match:
            die(f"Unrecognised PR comment URL: {url}\n"
                "Expected e.g. https://github.com/owner/repo/pull/123#discussion_r456789 "
                "or https://github.com/owner/repo/pull/123#issuecomment-456789")

        owner, repo, number, comment_id = match.groups()

        print(f"Fetching issue comment {comment_id} on {owner}/{repo}#{number}...")
        comment = get_issue_comment(owner, repo, comment_id)

        line = None
        path = None
        body = comment["body"]
        reviewer = comment.get("user") or "a reviewer"
        is_reply = False

        print(f"Reviewer: {reviewer}")

    print(f"Fetching branch for PR #{number}...")
    branch_name = get_pr_branch(owner, repo, number)
    print(f"Branch: {branch_name}")

    worktree_dirname = branch_name.replace('/', '-')
    worktree_path = AUTHD_REPO.parent / f"authd-{worktree_dirname}"

    print(f"Ensuring worktree at {worktree_path}...")
    result = subprocess.run(["authd-worktree", branch_name], cwd=AUTHD_REPO)
    if result.returncode != 0:
        die("Failed to create/open worktree")

    print(f"Opening Guake tab for {worktree_path}...")

    reply_note = " (this is a reply further down an existing review thread)" if is_reply else ""
    location_line = f"File: {path}, line: {line}\n" if path else ""
    prompt = (
        f"There's a reviewer comment from {reviewer} on {url}{reply_note}.\n"
        f"{location_line}"
        f"Comment: {body}\n"
    )
    q = shlex.quote(prompt)
    w = shlex.quote(str(worktree_path))
    # Prefix the command with a space so it isn't recorded in the shell
    # history (requires HISTCONTROL=ignorespace/ignoreboth in bash or
    # setopt HIST_IGNORE_SPACE in zsh, which is a common default).
    launch = (
        " cd {worktree}; clear; "
        "_p={prompt}; "
        "if [ -n \"$ZSH_VERSION\" ]; then "
        "vared -p $'Edit prompt, then press Enter:\\n' _p; "
        "else "
        "read -e -i \"$_p\" -p $'Edit prompt, then press Enter:\\n' _p; "
        "fi && "
        "copilot --autopilot --allow-all -i \"$_p\""
    ).format(worktree=w, prompt=q)
    guake_call("execute_command", launch + "\n")

    guake_call("show")

    print(f"Done! Prompt staged in new Guake tab for {url}. "
          "Edit it if needed, then press Enter to run Copilot.")


if __name__ == "__main__":
    main()
