#!/usr/bin/env bash

set -euo pipefail

usage() {
    cat << EOF
Usage: $0 [options]

Extracts all .journal files from downloaded CI artifacts and converts them into
plain-text logs that can be searched.

Options:
  --input <dir>
      Directory produced by .scripts/download-ci-test-logs
      (default: \$XDG_DATA_HOME/authd-artifacts or ~/.local/share/authd-artifacts)

  --output <dir>
      Directory where converted journal logs are written
      (default: <input>/journals-text)

  --format <journalctl-format>
      journalctl output format (default: short-iso)

  --search <term>
      Search this term in all converted journal logs and print matches.

  --ignore-case
      Case-insensitive search (only with --search).

  -h, --help
      Show this help message and exit.
EOF
}

INPUT_DIR=${XDG_DATA_HOME:-$HOME/.local/share}/authd-artifacts
OUTPUT_DIR=
JOURNALCTL_FORMAT=short-iso
SEARCH_TERM=
IGNORE_CASE=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        --input)
            INPUT_DIR="$2"
            shift 2
            ;;
        --output)
            OUTPUT_DIR="$2"
            shift 2
            ;;
        --format)
            JOURNALCTL_FORMAT="$2"
            shift 2
            ;;
        --search)
            SEARCH_TERM="$2"
            shift 2
            ;;
        --ignore-case)
            IGNORE_CASE=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "Unknown option: $1" >&2
            usage
            exit 1
            ;;
    esac
done

if [[ ! -d "$INPUT_DIR" ]]; then
    echo "Input directory does not exist: $INPUT_DIR" >&2
    exit 1
fi

if [[ -z "$OUTPUT_DIR" ]]; then
    OUTPUT_DIR="${INPUT_DIR}/journals-text"
fi

if ! command -v journalctl >/dev/null 2>&1; then
    echo "journalctl not found in PATH" >&2
    exit 1
fi

mkdir -p "$OUTPUT_DIR"

mapfile -d '' -t JOURNAL_FILES < <(find "$INPUT_DIR" -type f -name '*.journal' -print0 | sort -z)
if [[ ${#JOURNAL_FILES[@]} -eq 0 ]]; then
    echo "No .journal files found under $INPUT_DIR"
    exit 0
fi

echo "Converting ${#JOURNAL_FILES[@]} journal file(s) ..."

converted=0
failed=0
for journal_file in "${JOURNAL_FILES[@]}"; do
    rel_path=${journal_file#"$INPUT_DIR"/}
    out_file="${OUTPUT_DIR}/${rel_path}.log"
    mkdir -p "$(dirname "$out_file")"

    if journalctl --no-pager --file="$journal_file" -o "$JOURNALCTL_FORMAT" > "$out_file"; then
        (( converted++ )) || true
    else
        echo "Failed to convert: $journal_file" >&2
        (( failed++ )) || true
    fi
done

echo "Converted: $converted  Failed: $failed"
echo "Output directory: $OUTPUT_DIR"

if [[ -n "$SEARCH_TERM" ]]; then
    echo
    echo "Searching for: $SEARCH_TERM"
    if command -v rg >/dev/null 2>&1; then
        if [[ "$IGNORE_CASE" -eq 1 ]]; then
            rg --no-heading --line-number --color=never -i -- "$SEARCH_TERM" "$OUTPUT_DIR" || true
        else
            rg --no-heading --line-number --color=never -- "$SEARCH_TERM" "$OUTPUT_DIR" || true
        fi
    else
        if [[ "$IGNORE_CASE" -eq 1 ]]; then
            grep -RIn -- "$SEARCH_TERM" "$OUTPUT_DIR" || true
        else
            grep -Rn -- "$SEARCH_TERM" "$OUTPUT_DIR" || true
        fi
    fi
fi
