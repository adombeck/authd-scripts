#!/bin/dash

if [ "$#" -ne 1 ]; then
    echo "Usage: source $0 <branch-name>" >&2
    return 1 2>/dev/null || exit 1
fi

branch="$1"
workspace="../authd-${branch}"

(
    set -euo pipefail

    if [ ! -d "$workspace" ]; then
        if git show-ref --verify --quiet "refs/heads/$branch"; then
            git worktree add \
                "$workspace" \
                "$branch"
        else
            remote_branch=$(git for-each-ref \
                --format='%(refname:short)' \
                "refs/remotes/*/$branch" \
                | head -n1)

            if [ -n "$remote_branch" ]; then
                git worktree add \
                    --track \
                    -b "$branch" \
                    "$workspace" \
                    "$remote_branch"
            else
                git worktree add \
                    -b "$branch" \
                    "$workspace"
            fi
        fi

        # Set up the submodule for libhimmelblau.
        SUBMOD=authd-oidc-brokers/third_party/libhimmelblau
        WORKTREE=$(basename "$(git rev-parse --show-toplevel)")
        MAINREPO="$(git rev-parse --show-toplevel | xargs -I{} dirname {})/authd"

        rm -rf \
            "$MAINREPO/.git/worktrees/$WORKTREE/modules/$SUBMOD" \
            "$SUBMOD/.git"

        git submodule update --init --recursive "$SUBMOD"
    fi
) || return 1

cd "$workspace" || return 1
