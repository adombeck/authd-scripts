#!/bin/dash

usage() {
    echo "Usage: source $0 <branch-name>" >&2
    echo "       source $0 --cleanup [--force]" >&2
    echo "       $0 --setup-submodule <submodule-path> <ref>" >&2
    echo >&2
    echo "  --setup-submodule: sets up a submodule that doesn't exist on the current" >&2
    echo "    branch but does on <ref>. Run from the worktree before 'git reset --hard <ref>'." >&2
}

# _submod_linked_gitdir <main-submod-git> <worktree-submod-git> <checkout> <commit>
#
# Creates the linked worktree git dir and working-tree checkout for a submodule.
# See setup_submodule for the rationale behind the manual construction.
_submod_linked_gitdir() {
    _MSG="$1"
    _WTG="$2"
    _CKO="$3"
    _CMT="$4"

    git --git-dir="$_MSG" worktree prune 2>/dev/null || true
    rm -rf "$_WTG" "$_CKO"

    # Manually construct a proper linked worktree git dir at the path git expects.
    # IMPORTANT: the path must end with the full submodule name; git validates this
    # in submodule.c and BUGs out if it doesn't match. Using "git worktree add" on
    # the submodule itself puts the git dir under worktrees/<name>/ which fails that
    # check, so we build the structure by hand instead.
    mkdir -p "$_WTG"
    printf '%s\n' "$_CMT"  > "$_WTG/HEAD"
    printf '%s\n' "$_MSG"  > "$_WTG/commondir"
    printf '%s\n' "$_CKO/.git" > "$_WTG/gitdir"

    mkdir -p "$_CKO"
    printf 'gitdir: %s\n' "$_WTG" > "$_CKO/.git"
    git --git-dir="$_WTG" --work-tree="$_CKO" checkout -f HEAD -- .
}

# setup_submodule <mainrepo> <workspace-abs> <worktree-name> <submod-path>
#
# Sets up a submodule as a proper linked worktree git dir. The submodule must
# already be listed in the worktree's .gitmodules (i.e. exist on its HEAD).
# Must be called from within the main repo.
setup_submodule() {
    _SS_MAINREPO="$1"
    _SS_WORKSPACE="$2"
    _SS_WTNAME="$3"
    _SS_SUBMOD="$4"

    _SS_MSG="$_SS_MAINREPO/.git/modules/$_SS_SUBMOD"
    _SS_WTG="$_SS_MAINREPO/.git/worktrees/$_SS_WTNAME/modules/$_SS_SUBMOD"
    _SS_CKO="$_SS_WORKSPACE/$_SS_SUBMOD"

    # Ensure the submodule is initialized in the main repo.
    git submodule update --init "$_SS_SUBMOD"

    _SS_COMMIT=$(git -C "$_SS_WORKSPACE" ls-tree HEAD "$_SS_SUBMOD" | awk '{print $3}')

    _submod_linked_gitdir "$_SS_MSG" "$_SS_WTG" "$_SS_CKO" "$_SS_COMMIT"
}

# setup_submodule_from_worktree <submod-path> <ref>
#
# Sets up a submodule that is present on <ref> but not on the current HEAD.
# Must be called from within the linked worktree. Initialises the main module
# git dir by cloning if necessary, then sets up the linked worktree git dir.
# After this, 'git reset --hard <ref>' will succeed.
setup_submodule_from_worktree() {
    _SWFT_SUBMOD="$1"
    _SWFT_REF="$2"

    _SWFT_WORKSPACE="$(git rev-parse --show-toplevel)"
    _SWFT_COMMON="$(git rev-parse --git-common-dir)"
    _SWFT_MAINREPO="$(cd "$_SWFT_COMMON/.." && pwd)"
    _SWFT_WTNAME="$(basename "$_SWFT_WORKSPACE")"

    _SWFT_MSG="$_SWFT_MAINREPO/.git/modules/$_SWFT_SUBMOD"
    _SWFT_WTG="$_SWFT_MAINREPO/.git/worktrees/$_SWFT_WTNAME/modules/$_SWFT_SUBMOD"
    _SWFT_CKO="$_SWFT_WORKSPACE/$_SWFT_SUBMOD"

    # Get the URL and commit from the target ref's .gitmodules and tree.
    _SWFT_TF=$(mktemp)
    git show "$_SWFT_REF:.gitmodules" > "$_SWFT_TF" 2>/dev/null
    _SWFT_URL=$(git config --file "$_SWFT_TF" "submodule.$_SWFT_SUBMOD.url" 2>/dev/null)
    rm -f "$_SWFT_TF"

    if [ -z "$_SWFT_URL" ]; then
        echo "error: submodule '$_SWFT_SUBMOD' not found in $_SWFT_REF:.gitmodules" >&2
        return 1 2>/dev/null || exit 1
    fi

    _SWFT_COMMIT=$(git ls-tree "$_SWFT_REF" "$_SWFT_SUBMOD" | awk '{print $3}')
    if [ -z "$_SWFT_COMMIT" ]; then
        echo "error: submodule '$_SWFT_SUBMOD' not found in tree of $_SWFT_REF" >&2
        return 1 2>/dev/null || exit 1
    fi

    # If the main module git dir doesn't exist yet, clone it.
    if [ ! -d "$_SWFT_MSG" ]; then
        _SWFT_TMP=$(mktemp -d)
        git clone --quiet --no-checkout \
            --separate-git-dir="$_SWFT_MSG" \
            "$_SWFT_URL" "$_SWFT_TMP/checkout"
        rm -rf "$_SWFT_TMP"
        # Fix core.worktree: from .git/modules/<submod>/ to <mainrepo>/<submod>/,
        # the relative path is (num_path_components + 2) levels up, then <submod>.
        _SWFT_NCOMP=$(printf '%s' "$_SWFT_SUBMOD" | awk -F/ '{print NF}')
        _SWFT_UPS=$((_SWFT_NCOMP + 2))
        _SWFT_REL=""
        _i=0
        while [ "$_i" -lt "$_SWFT_UPS" ]; do
            _SWFT_REL="${_SWFT_REL}../"
            _i=$((_i + 1))
        done
        git --git-dir="$_SWFT_MSG" config core.worktree "${_SWFT_REL}${_SWFT_SUBMOD}"
    fi

    _submod_linked_gitdir "$_SWFT_MSG" "$_SWFT_WTG" "$_SWFT_CKO" "$_SWFT_COMMIT"
}

# _seed_intellij_cache <source-abs-path> <dest-abs-path>
#
# Copies the IntelliJ project index cache from an existing worktree to the new
# one so IntelliJ doesn't have to reindex from scratch. JetBrains names the
# cache directory <basename>.<hash> where <hash> is the Java String.hashCode()
# of the absolute project path, formatted as 8 lowercase hex digits.
# Silently skips if python3 is unavailable, no IntelliJ cache exists, or the
# source cache directory hasn't been created yet (i.e. source never opened).
_seed_intellij_cache() {
    _SIC_SOURCE="$1"
    _SIC_DEST="$2"

    if ! command -v python3 >/dev/null 2>&1; then
        return 0
    fi

    _SIC_CACHE_BASE=$(ls -dt "$HOME/.cache/JetBrains/IntelliJIdea"*/projects 2>/dev/null | head -1)
    if [ -z "$_SIC_CACHE_BASE" ]; then
        return 0
    fi

    _jb_hash() {
        python3 -c "
h = 0
for c in '$1':
    h = (31 * h + ord(c)) & 0xFFFFFFFF
print(f'{h:08x}')
"
    }

    _SIC_SRC_HASH=$(_jb_hash "$_SIC_SOURCE")
    _SIC_DST_HASH=$(_jb_hash "$_SIC_DEST")

    _SIC_SRC_DIR="${_SIC_CACHE_BASE}/$(basename "$_SIC_SOURCE").${_SIC_SRC_HASH}"
    _SIC_DST_DIR="${_SIC_CACHE_BASE}/$(basename "$_SIC_DEST").${_SIC_DST_HASH}"

    if [ ! -d "$_SIC_SRC_DIR" ]; then
        return 0
    fi

    if [ -d "$_SIC_DST_DIR" ]; then
        return 0
    fi

    echo "Seeding IntelliJ index cache..."
    cp -r "$_SIC_SRC_DIR" "$_SIC_DST_DIR"
}

# _seed_intellij_idea <source-abs-path> <dest-abs-path>
#
# Copies the .idea/ directory from source to dest, adapting the .iml filename
# to match the new project name. Excludes workspace.xml (user session state).
# Skips silently if the source has no .idea/ or the dest already has one.
_seed_intellij_idea() {
    _SII_SOURCE="$1"
    _SII_DEST="$2"

    _SII_SRC_IDEA="$_SII_SOURCE/.idea"
    _SII_DST_IDEA="$_SII_DEST/.idea"

    if [ ! -d "$_SII_SRC_IDEA" ]; then
        return 0
    fi

    if [ -d "$_SII_DST_IDEA" ]; then
        return 0
    fi

    echo "Seeding IntelliJ .idea/ directory..."
    cp -r "$_SII_SRC_IDEA" "$_SII_DST_IDEA"
    rm -f "$_SII_DST_IDEA/workspace.xml"

    # Rename the .iml file and update the reference in modules.xml.
    _SII_SRC_NAME=$(basename "$_SII_SOURCE")
    _SII_DST_NAME=$(basename "$_SII_DEST")
    _SII_SRC_IML="$_SII_DST_IDEA/${_SII_SRC_NAME}.iml"
    _SII_DST_IML="$_SII_DST_IDEA/${_SII_DST_NAME}.iml"

    if [ -f "$_SII_SRC_IML" ]; then
        mv "$_SII_SRC_IML" "$_SII_DST_IML"
        _SII_MODULES="$_SII_DST_IDEA/modules.xml"
        if [ -f "$_SII_MODULES" ]; then
            sed -i "s/${_SII_SRC_NAME}\.iml/${_SII_DST_NAME}.iml/g" "$_SII_MODULES"
        fi
    fi
}

create_worktree() {
    branch="$1"
    worktree_dirname=$(printf '%s' "$branch" | tr '/' '-')
    workspace="../authd-${worktree_dirname}"

    (
        set -euo pipefail

        if [ ! -d "$workspace" ]; then
            if git show-ref --verify --quiet "refs/heads/$branch"; then
                git worktree add \
                    "$workspace" \
                    "$branch"
            else
                remote_branch=$(git for-each-ref \
                    --format='%(refname:short)' \
                    "refs/remotes/*/$branch" \
                    | head -n1)

                if [ -n "$remote_branch" ]; then
                    git worktree add \
                        --track \
                        -b "$branch" \
                        "$workspace" \
                        "$remote_branch"
                else
                    git worktree add \
                        -b "$branch" \
                        "$workspace"
                fi
            fi

            MAINREPO="$(git rev-parse --show-toplevel)"
            WORKSPACE_ABS="$(cd "$workspace" && pwd)"
            WORKTREE_NAME="$(basename "$WORKSPACE_ABS")"

            # Set up each submodule declared in the new worktree.
            git config --file "$WORKSPACE_ABS/.gitmodules" --get-regexp 'submodule\..*\.path' \
            | awk '{print $2}' \
            | while IFS= read -r SUBMOD; do
                setup_submodule "$MAINREPO" "$WORKSPACE_ABS" "$WORKTREE_NAME" "$SUBMOD"
            done

            _seed_intellij_cache "$MAINREPO" "$WORKSPACE_ABS"
            _seed_intellij_idea "$MAINREPO" "$WORKSPACE_ABS"
        fi
    ) || return 1

    cd "$workspace" || return 1
}

cleanup_worktrees() {
    force=0
    if [ "${1:-}" = "--force" ]; then
        force=1
    elif [ -n "${1:-}" ]; then
        usage
        return 1
    fi

    # Determine the ref to compare against for "merged into main".
    main_ref=""
    for candidate in main origin/main; do
        if git show-ref --verify --quiet "refs/heads/$candidate" \
            || git show-ref --verify --quiet "refs/remotes/$candidate"; then
            main_ref="$candidate"
            break
        fi
    done

    if [ -z "$main_ref" ]; then
        echo "Could not find a 'main' branch to compare against." >&2
        return 1
    fi

    main_path=$(git rev-parse --show-toplevel)

    # Collect worktrees whose branch has been merged into main.
    # merged_squash holds "1" for branches detected as merged via gh but which
    # are NOT ancestors of main (likely squash merges), "0" otherwise.
    merged_paths=""
    merged_branches=""
    merged_squash=""
    cur_path=""
    cur_branch=""

    # is_merged <branch>
    #
    # Returns 0 if the branch is considered merged into main, 1 otherwise.
    # Sets the global LAST_MERGE_SQUASH to 1 when the branch is merged according
    # to gh but is NOT a git ancestor of main (i.e. likely squash-merged), 0
    # otherwise. gh failures (missing binary, no network, repo not on GitHub)
    # never abort cleanup: detection falls back to the git ancestor check only.
    is_merged() {
        branch="$1"
        LAST_MERGE_SQUASH=0

        is_ancestor=1
        if git merge-base --is-ancestor "refs/heads/$branch" "$main_ref" 2>/dev/null; then
            is_ancestor=0
        fi

        gh_merged=1
        if command -v gh >/dev/null 2>&1; then
            pr=$(gh pr list --head "$branch" --state merged \
                --json number --jq '.[0].number' 2>/dev/null)
            if [ -n "$pr" ]; then
                gh_merged=0
            fi
        fi

        if [ "$is_ancestor" -eq 0 ]; then
            return 0
        fi

        if [ "$gh_merged" -eq 0 ]; then
            LAST_MERGE_SQUASH=1
            return 0
        fi

        return 1
    }

    parse_worktree() {
        # $1 = path, $2 = branch (may be empty)
        path="$1"
        branch="$2"

        [ -z "$path" ] && return 0
        # Never remove the main worktree.
        [ "$path" = "$main_path" ] && return 0
        # Skip detached or unknown branches.
        [ -z "$branch" ] && return 0
        # Skip the main branch itself.
        [ "$branch" = "$main_ref" ] && return 0

        # Skip worktrees with uncommitted changes; warn so they aren't silently
        # ignored.
        if [ -n "$(git -C "$path" status --porcelain 2>/dev/null)" ]; then
            echo "Skipping $path ($branch): uncommitted changes." >&2
            return 0
        fi

        if is_merged "$branch"; then
            merged_paths="$merged_paths$path
"
            merged_branches="$merged_branches$branch
"
            merged_squash="$merged_squash$LAST_MERGE_SQUASH
"
        fi
    }

    while IFS= read -r line; do
        case "$line" in
            "worktree "*)
                cur_path="${line#worktree }"
                cur_branch=""
                ;;
            "branch refs/heads/"*)
                cur_branch="${line#branch refs/heads/}"
                ;;
            "")
                parse_worktree "$cur_path" "$cur_branch"
                cur_path=""
                cur_branch=""
                ;;
        esac
    done <<EOF
$(git worktree list --porcelain)

EOF

    if [ -z "$merged_paths" ]; then
        echo "No worktrees merged into $main_ref to clean up."
        return 0
    fi

    echo "The following worktrees have been merged into $main_ref and will be removed."
    echo "Their local branches will also be force-deleted (git branch -D)."
    echo
    echo "Entries marked [squash-merged] are not ancestors of $main_ref, so any"
    echo "commits unique to those branches will be lost when the branch is deleted."
    echo
    # Print branch / path pairs, annotating squash merges.
    i=1
    echo "$merged_paths" | while IFS= read -r p; do
        [ -z "$p" ] && continue
        b=$(echo "$merged_branches" | sed -n "${i}p")
        s=$(echo "$merged_squash" | sed -n "${i}p")
        if [ "$s" = "1" ]; then
            echo "  $b -> $p  [squash-merged: not an ancestor of $main_ref]"
        else
            echo "  $b -> $p"
        fi
        i=$((i + 1))
    done
    echo

    if [ "$force" -ne 1 ]; then
        printf "Remove these worktrees, their directories, and branches? [y/N] "
        read -r answer
        case "$answer" in
            [yY] | [yY][eE][sS]) ;;
            *)
                echo "Aborted."
                return 1
                ;;
        esac
    fi

    i=1
    echo "$merged_paths" | while IFS= read -r p; do
        [ -z "$p" ] && continue
        b=$(echo "$merged_branches" | sed -n "${i}p")
        i=$((i + 1))
        echo "Removing $p"
        if ! git worktree remove --force "$p"; then
            rm -rf "$p"
            # Prune stale metadata so the branch can be deleted below.
            git worktree prune
        fi
        # Ensure the directory is gone.
        rm -rf "$p"
        if [ -n "$b" ]; then
            echo "Deleting branch $b"
            git branch -D "$b"
        fi
    done

    git worktree prune
}

if [ "$#" -lt 1 ]; then
    usage
    return 1 2>/dev/null || exit 1
fi

case "$1" in
    --cleanup)
        shift
        cleanup_worktrees "$@"
        ;;
    --setup-submodule)
        if [ "$#" -ne 3 ]; then
            usage
            return 1 2>/dev/null || exit 1
        fi
        setup_submodule_from_worktree "$2" "$3"
        ;;
    -h | --help)
        usage
        ;;
    -*)
        usage
        return 1 2>/dev/null || exit 1
        ;;
    *)
        if [ "$#" -ne 1 ]; then
            usage
            return 1 2>/dev/null || exit 1
        fi
        create_worktree "$1"
        ;;
esac
