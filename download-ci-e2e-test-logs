#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
OUTPUT_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/authd-e2e-artifacts"

exec "${SCRIPT_DIR}/download-ci-workflow-artifacts" \
    --repo "canonical/authd" \
    --workflow "e2e-tests.yaml" \
    --branch "main" \
    --artifact-prefix "e2e-tests-" \
    --no-job-filter \
    --output "$OUTPUT_DIR" \
    --extract "*.journal" \
    "$@"
