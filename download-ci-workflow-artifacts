#!/usr/bin/env bash
#
# Downloads selected artifacts from GitHub Actions workflow runs
# and extracts only requested files. Previously extracted files are reused when
# the requested files are still available locally. If a requested extraction is
# missing, the artifact is downloaded again. HTML extractions also include
# local files referenced by the HTML, such as screenshots and recordings.
#
# Requirements:
#   - gh CLI authenticated (gh auth login)
#   - jq

set -euo pipefail

usage() {
    cat << EOF
Usage: $0 [options]

Downloads workflow artifacts and extracts only selected files.

The cache is checked in the filesystem against the requested extraction
patterns. If the requested files are missing, the artifact is downloaded
again. When an HTML file is requested, local files referenced by it are
extracted as well. A full '*' extraction is refreshed because filesystem
contents cannot prove that every archive member is present.

Required options:
  --repo <owner/repo>
      GitHub repository to query.

  --workflow <filename>
      Workflow filename to filter runs by (for example: qa.yaml).
      Required unless --run-id is provided.

  --branch <branch>
      Branch name to filter runs by.
      Required unless --run-id is provided.

  --artifact-prefix <prefix>
      Only download artifacts whose names start with this prefix.

  --output <dir>
      Directory where artifacts are extracted.

  --extract <glob>
      File glob to extract from each artifact zip (can be used multiple times).
      Examples: --extract "*.log" --extract "*.journal"

Run selection:
  --run-id <run-id>
      Download artifacts for exactly this workflow run. When provided,
      --workflow, --branch, and date options must not be provided.

  --from <date-or-iso>
      Start of date range, inclusive (for example: 2026-06-01).

  --to <date-or-iso>
      End of date range, inclusive (for example: 2026-06-08).

  --days <n>
      Number of days back to query if --from/--to are not provided.

Job filtering (choose one mode):
  --job <job-name>
      Require this job to be present in each run.

  --no-job-filter
      Do not require a specific job in each run.

  -h, --help
      Show this help message and exit.
EOF
}

EXTRACT_PATTERNS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --repo)
            REPO="$2"
            shift 2
            ;;
        --workflow)
            WORKFLOW="$2"
            shift 2
            ;;
        --branch)
            BRANCH="$2"
            shift 2
            ;;
        --run-id)
            RUN_ID_FILTER="$2"
            shift 2
            ;;
        --artifact-prefix)
            ARTIFACT_PREFIX="$2"
            shift 2
            ;;
        --output)
            OUTPUT_DIR="$2"
            shift 2
            ;;
        --from)
            DATE_FROM="$2"
            shift 2
            ;;
        --to)
            DATE_TO="$2"
            shift 2
            ;;
        --days)
            DAYS="$2"
            shift 2
            ;;
        --job)
            JOB_NAME="$2"
            shift 2
            ;;
        --no-job-filter)
            NO_JOB_FILTER=1
            shift
            ;;
        --extract)
            EXTRACT_PATTERNS+=("$2")
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "Unknown option: $1" >&2
            usage
            exit 1
            ;;
    esac
done

NO_JOB_FILTER=${NO_JOB_FILTER:-0}

if [[ -z "${REPO:-}" || -z "${ARTIFACT_PREFIX:-}" || -z "${OUTPUT_DIR:-}" ]]; then
    echo "Missing required options." >&2
    usage
    exit 1
fi

if [[ -n "${RUN_ID_FILTER:-}" ]]; then
    if ! [[ "$RUN_ID_FILTER" =~ ^[0-9]+$ ]]; then
        echo "--run-id must be a numeric workflow run ID." >&2
        exit 1
    fi
    if [[ -n "${WORKFLOW:-}" || -n "${BRANCH:-}" ||
        -n "${DATE_FROM:-}" || -n "${DATE_TO:-}" || -n "${DAYS:-}" ]]; then
        echo "--run-id cannot be combined with workflow, branch, or date filters." >&2
        exit 1
    fi
elif [[ -z "${WORKFLOW:-}" || -z "${BRANCH:-}" ]]; then
    echo "Provide --workflow and --branch, or use --run-id." >&2
    usage
    exit 1
fi

if [[ ${#EXTRACT_PATTERNS[@]} -eq 0 ]]; then
    echo "At least one --extract pattern is required." >&2
    usage
    exit 1
fi

if [[ "$NO_JOB_FILTER" -eq 1 && -n "${JOB_NAME:-}" ]]; then
    echo "Use either --job or --no-job-filter, not both." >&2
    exit 1
fi

if [[ "$NO_JOB_FILTER" -ne 1 && -z "${JOB_NAME:-}" ]]; then
    echo "Provide --job or use --no-job-filter." >&2
    exit 1
fi

if [[ -n "${RUN_ID_FILTER:-}" ]]; then
    CREATED_QUERY="exact run ${RUN_ID_FILTER}"
else
    if [[ -z "${DATE_FROM:-}" && -z "${DATE_TO:-}" && -z "${DAYS:-}" ]]; then
        echo "Provide --days or a --from/--to date range." >&2
        exit 1
    fi

    if [[ -n "${DATE_FROM:-}" && -n "${DATE_TO:-}" ]]; then
        CREATED_QUERY="${DATE_FROM}..${DATE_TO}"
    elif [[ -n "${DATE_FROM:-}" ]]; then
        CREATED_QUERY=">=${DATE_FROM}"
    elif [[ -n "${DATE_TO:-}" ]]; then
        CREATED_QUERY="<=${DATE_TO}"
    else
        CUTOFF=$(date -u --date="$DAYS days ago" +%Y-%m-%dT%H:%M:%SZ)
        CREATED_QUERY=">=${CUTOFF}"
    fi
fi

echo "Repository : $REPO"
if [[ -n "${RUN_ID_FILTER:-}" ]]; then
    echo "Run        : $RUN_ID_FILTER"
else
    echo "Workflow   : $WORKFLOW"
    echo "Branch     : $BRANCH"
fi
echo "Artifacts  : prefix '$ARTIFACT_PREFIX'"
if [[ "$NO_JOB_FILTER" -eq 1 ]]; then
    echo "Job filter : disabled"
else
    echo "Job filter : $JOB_NAME"
fi
echo "Created    : $CREATED_QUERY"
echo "Extract    : ${EXTRACT_PATTERNS[*]}"
echo "Output dir : $OUTPUT_DIR"
echo
if [[ -n "${RUN_ID_FILTER:-}" ]]; then
    RUNS_JSON=$(gh api \
        -H "Accept: application/vnd.github+json" \
        "/repos/${REPO}/actions/runs/${RUN_ID_FILTER}" \
        --jq '{id: .id, created_at: .created_at, conclusion: .conclusion}')
else
    RUNS_ENDPOINT="/repos/${REPO}/actions/workflows/${WORKFLOW}/runs?per_page=100&branch=${BRANCH}&created=${CREATED_QUERY}"
    RUNS_JSON=$(gh api \
        --paginate \
        -H "Accept: application/vnd.github+json" \
        "$RUNS_ENDPOINT" \
        --jq ".workflow_runs[] | {id: .id, created_at: .created_at, conclusion: .conclusion}")
fi

if [[ -z "$RUNS_JSON" ]]; then
    echo "No runs found."
    exit 0
fi

mapfile -t RUN_IDS < <(echo "$RUNS_JSON" | jq -r '.id')
mapfile -t RUN_DATES < <(echo "$RUNS_JSON" | jq -r '.created_at')
mapfile -t RUN_CONCLUSIONS < <(echo "$RUNS_JSON" | jq -r '.conclusion')

echo "Found ${#RUN_IDS[@]} run(s)."
echo

job_ran_in_run() {
    local run_id="$1"
    gh api \
        -H "Accept: application/vnd.github+json" \
        "/repos/${REPO}/actions/runs/${run_id}/jobs" \
        2>/dev/null | jq -e --arg name "$JOB_NAME" '.jobs[] | select(.name == $name) | .id' >/dev/null
}

run_metadata() {
    local run_id="$1"
    local run_json event pr_number head_sha head_branch event_id

    run_json=$(gh api \
        -H "Accept: application/vnd.github+json" \
        "/repos/${REPO}/actions/runs/${run_id}" \
        2>/dev/null) || return 1

    event=$(printf '%s' "$run_json" | jq -r '.event // ""')
    pr_number=$(printf '%s' "$run_json" | jq -r '.pull_requests[0].number // ""')
    head_sha=$(printf '%s' "$run_json" | jq -r '.head_sha // ""')
    head_branch=$(printf '%s' "$run_json" | jq -r '.head_branch // ""')

    if [[ "$event" == pull_request* && -z "$pr_number" && -n "$head_sha" ]]; then
        pr_number=$(gh api \
            -H "Accept: application/vnd.github+json" \
            "/repos/${REPO}/commits/${head_sha}/pulls" \
            --jq '.[0].number // ""' 2>/dev/null || true)
    fi

    if [[ "$event" == pull_request* && -z "$pr_number" && -n "$head_branch" ]]; then
        pr_number=$(gh pr list \
            --repo "$REPO" \
            --state all \
            --head "$head_branch" \
            --limit 1 \
            --json number \
            --jq '.[0].number // ""' 2>/dev/null || true)
    fi

    if [[ "$event" != pull_request* ]]; then
        pr_number=""
    fi

    if [[ -n "$head_sha" ]]; then
        event_id="${head_sha:0:12}"
    else
        event_id="$run_id"
    fi

    printf '%s\t%s\t%s' "$event" "$pr_number" "$event_id"
}

pattern_matches_html() {
    local pattern="$1"
    [[ "$pattern" == *".html"* || "$pattern" == *".htm"* ]]
}

local_pattern_matches() {
    local directory="$1"
    local pattern="$2"
    local file relative

    while IFS= read -r -d '' file; do
        relative="${file#"$directory"/}"
        # shellcheck disable=SC2053
        if [[ "$relative" == $pattern ]]; then
            return 0
        fi
    done < <(find "$directory" -type f ! -name meta.json -print0)

    return 1
}

html_reference_paths() {
    local directory="$1"
    local html_file="$2"
    local html_relative html_directory attribute reference candidate resolved
    local shell_template="\${"

    html_relative="${html_file#"$directory"/}"
    html_directory="${html_relative%/*}"
    if [[ "$html_directory" == "$html_relative" ]]; then
        html_directory=""
    fi

    while IFS= read -r attribute; do
        reference="${attribute#*=}"
        reference="${reference#\"}"
        reference="${reference%\"}"
        reference="${reference%%\?*}"
        reference="${reference%%#*}"

        if [[ -z "$reference" || "$reference" == /* ||
            "$reference" == data:* || "$reference" == javascript:* ||
            "$reference" == *"://"* || "$reference" == *"{{"* ||
            "$reference" == *"}}"* || "$reference" == *"$shell_template"* ||
            "$reference" == *'}'* ]]; then
            continue
        fi

        if [[ -n "$html_directory" ]]; then
            candidate="$html_directory/$reference"
        else
            candidate="$reference"
        fi
        resolved="$(realpath -m -- "$directory/$candidate")" || continue
        case "$resolved" in
            "$directory"/*)
                printf '%s\n' "${resolved#"$directory"/}"
                ;;
        esac
    done < <(
        {
            grep -oE '(src|href)="[^"]+"' "$html_file" || true
            grep -oE '(src|href)=\\"[^\\"]+\\"' "$html_file" |
                sed 's/\\"/"/g' || true
        }
    )
}

html_dependencies_present() {
    local directory="$1"
    local pattern="$2"
    local file relative dependency found=0

    while IFS= read -r -d '' file; do
        relative="${file#"$directory"/}"
        # shellcheck disable=SC2053
        if [[ "$relative" != $pattern ]]; then
            continue
        fi
        found=1
        while IFS= read -r dependency; do
            if [[ ! -f "$directory/$dependency" ]]; then
                return 1
            fi
        done < <(html_reference_paths "$directory" "$file")
    done < <(find "$directory" -type f \( -iname '*.html' -o -iname '*.htm' \) -print0)

    [[ "$found" -eq 1 ]]
}

cache_satisfies_request() {
    local directory="$1"
    local metadata="$2"
    local pattern

    [[ -f "$metadata" ]] || return 1

    for pattern in "${EXTRACT_PATTERNS[@]}"; do
        if [[ "$pattern" == "*" ]]; then
            # Filesystem contents cannot prove that every archive member was
            # extracted, so refresh full-archive requests.
            return 1
        elif pattern_matches_html "$pattern"; then
            html_dependencies_present "$directory" "$pattern" || return 1
        else
            local_pattern_matches "$directory" "$pattern" || return 1
        fi
    done

    return 0
}

mkdir -p "$OUTPUT_DIR"

DOWNLOADED=0
SKIPPED=0

for i in "${!RUN_IDS[@]}"; do
    RUN_ID="${RUN_IDS[$i]}"
    RUN_DATE="${RUN_DATES[$i]}"
    RUN_CONCLUSION="${RUN_CONCLUSIONS[$i]}"
    RUN_EVENT=""
    RUN_PR=""
    RUN_EVENT_ID="$RUN_ID"
    if run_meta="$(run_metadata "$RUN_ID")"; then
        RUN_EVENT="$(printf '%s' "$run_meta" | cut -f1)"
        RUN_PR="$(printf '%s' "$run_meta" | cut -f2)"
        RUN_EVENT_ID="$(printf '%s' "$run_meta" | cut -f3)"
    fi

    if [[ -n "$RUN_PR" ]]; then
        RUN_SCOPE="pr-${RUN_PR}"
    else
        RUN_SCOPE="${RUN_EVENT:-unknown}-${RUN_EVENT_ID:-$RUN_ID}"
    fi
    RUN_DIR="${OUTPUT_DIR}/${RUN_SCOPE}/run-${RUN_ID}"
    mkdir -p "$RUN_DIR"

    echo "Run $RUN_ID  (${RUN_DATE}  conclusion: ${RUN_CONCLUSION})"

    if [[ "$NO_JOB_FILTER" -ne 1 ]]; then
        if ! job_ran_in_run "$RUN_ID"; then
            echo "  Job '$JOB_NAME' not found in this run, skipping."
            (( SKIPPED++ )) || true
            continue
        fi
    fi

    ARTIFACTS_JSON=$(gh api \
        -H "Accept: application/vnd.github+json" \
        "/repos/${REPO}/actions/runs/${RUN_ID}/artifacts?per_page=100" \
        --jq ".artifacts[] | select(.name | startswith(\"$ARTIFACT_PREFIX\")) | {id: .id, name: .name}")

    if [[ -z "$ARTIFACTS_JSON" ]]; then
        echo "  No matching artifacts found."
        (( SKIPPED++ )) || true
        continue
    fi

    while IFS= read -r artifact_line; do
        ARTIFACT_ID=$(echo "$artifact_line" | jq -r '.id')
        ARTIFACT_NAME=$(echo "$artifact_line" | jq -r '.name')

        DEST_DIR="${RUN_DIR}/${ARTIFACT_NAME}"
        META_FILE="${DEST_DIR}/meta.json"
        if cache_satisfies_request "$DEST_DIR" "$META_FILE"; then
            echo "  Artifact '$ARTIFACT_NAME' already contains the requested files in $DEST_DIR, skipping."
            (( SKIPPED++ )) || true
            continue
        fi
        if [[ -f "$META_FILE" ]]; then
            echo "  Artifact '$ARTIFACT_NAME' is missing requested files; downloading it again."
        fi
        mkdir -p "$DEST_DIR"

        ZIP_FILE="${DEST_DIR}/artifact.zip"

        echo "  Downloading artifact '$ARTIFACT_NAME' (id: $ARTIFACT_ID) ..."
        if ! gh api \
            -H "Accept: application/vnd.github+json" \
            "/repos/${REPO}/actions/artifacts/${ARTIFACT_ID}/zip" \
            > "$ZIP_FILE"; then
            echo "  ERROR: download failed, skipping."
            rm -f "$ZIP_FILE"
            continue
        fi

        mapfile -t ZIP_ENTRIES < <(unzip -Z1 "$ZIP_FILE" | sed '/\/$/d')
        declare -A ZIP_ENTRY_SET=()
        declare -A SELECTED_ENTRY_SET=()
        SELECTED_ENTRIES=()
        for entry in "${ZIP_ENTRIES[@]}"; do
            ZIP_ENTRY_SET["$entry"]=1
        done

        select_entry() {
            local entry="$1"
            if [[ -z "${SELECTED_ENTRY_SET[$entry]+present}" ]]; then
                SELECTED_ENTRY_SET["$entry"]=1
                SELECTED_ENTRIES+=("$entry")
            fi
        }

        for pattern in "${EXTRACT_PATTERNS[@]}"; do
            pattern_found=0
            for entry in "${ZIP_ENTRIES[@]}"; do
                # shellcheck disable=SC2053
                if [[ "$entry" == $pattern ]]; then
                    select_entry "$entry"
                    pattern_found=1
                fi
            done
            if [[ "$pattern_found" -eq 0 ]]; then
                echo "  No files matching '$pattern' in this artifact."
            fi
        done

        HTML_REQUESTED=0
        for pattern in "${EXTRACT_PATTERNS[@]}"; do
            if pattern_matches_html "$pattern"; then
                HTML_REQUESTED=1
                break
            fi
        done

        if [[ "$HTML_REQUESTED" -eq 1 ]]; then
            for entry in "${ZIP_ENTRIES[@]}"; do
                case "$entry" in
                    *.html|*.htm)
                        select_entry "$entry"
                        ;;
                esac
            done
        fi

        echo "  Extracting selected files to $DEST_DIR ..."
        if [[ ${#SELECTED_ENTRIES[@]} -gt 0 ]] &&
            ! unzip -q -o "$ZIP_FILE" "${SELECTED_ENTRIES[@]}" -d "$DEST_DIR"; then
            echo "  ERROR: failed to extract selected files." >&2
            rm -f "$ZIP_FILE"
            continue
        fi

        if [[ "$HTML_REQUESTED" -eq 1 ]]; then
            while IFS= read -r -d '' html_file; do
                while IFS= read -r dependency; do
                    if [[ -n "${ZIP_ENTRY_SET[$dependency]+present}" ]]; then
                        select_entry "$dependency"
                    fi
                done < <(html_reference_paths "$DEST_DIR" "$html_file")
            done < <(find "$DEST_DIR" -type f \( -iname '*.html' -o -iname '*.htm' \) -print0)

            if [[ ${#SELECTED_ENTRIES[@]} -gt 0 ]] &&
                ! unzip -q -o "$ZIP_FILE" "${SELECTED_ENTRIES[@]}" -d "$DEST_DIR"; then
                echo "  ERROR: failed to extract HTML dependencies." >&2
                rm -f "$ZIP_FILE"
                continue
            fi
        fi
        rm -f "$ZIP_FILE"

        jq -n \
            --arg run_id "$RUN_ID" \
            --arg pr_number "$RUN_PR" \
            --arg event "$RUN_EVENT" \
            --arg event_id "$RUN_EVENT_ID" \
            --arg run_scope "$RUN_SCOPE" \
            --arg run_date "$RUN_DATE" \
            --arg conclusion "$RUN_CONCLUSION" \
            --arg artifact_name "$ARTIFACT_NAME" \
            --arg artifact_id "$ARTIFACT_ID" \
            '{run_id: $run_id, pr_number: $pr_number, event: $event, event_id: $event_id, run_scope: $run_scope, run_date: $run_date, conclusion: $conclusion, artifact_name: $artifact_name, artifact_id: $artifact_id}' \
            > "$META_FILE"

        (( DOWNLOADED++ )) || true
    done < <(echo "$ARTIFACTS_JSON" | jq -c '.')
done

echo
echo "Done.  Downloaded: $DOWNLOADED  Skipped: $SKIPPED"
echo "Artifacts are in: $OUTPUT_DIR"
